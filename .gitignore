# Secrets: credentials belong in the macOS Keychain, never in files.
# These patterns catch any that end up on disk by mistake.
.env
.env.*
*.pem
*.key
*.p12
credentials*.json
client_secret*.json
token*.json
*.secret
secrets/

# Service state: the database holds task titles, deadlines and links.
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3-wal
*.sqlite3-shm
*.startup.lock
data/

# Logs can contain task titles and ids.
*.log
logs/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/
.hypothesis/

# macOS and editors
.DS_Store
.vscode/
.idea/

# Claude Code local settings (per machine)
.claude/settings.local.json
